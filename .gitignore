# Compilados y artefactos de build
**/target/
backend/target/
*.class
node_modules/

# Logs
*.log

# IDEs
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Empaquetado alpha (issue #36): JREs descargados y zips generados
dist/.cache/
dist/salida/

# Caché de importación de Godot: se regenera con `godot4 --import`
godot/.godot/

# Núcleo GB de #124: dependencias pinneadas y binarios se regeneran en CI/local.
godot/native/siga98_gb/.deps/
godot/native/siga98_gb/bin/
godot/addons/siga98_gb/bin/
godot/roms/*.gb
godot/roms/*.gbc

# Sistema
.DS_Store
Thumbs.db

# Secretos y configuración local (credenciales de desarrollo, nunca en el repo)
.env
.env.*
!.env.example

# Configuración local de Claude Code (permisos específicos de esta máquina)
.claude/settings.local.json

# Cache/logs de sesión de herramientas de modernización automática
.github/modernize/

# Notas de Claude Code para sí mismo: uso local, no se versiona
CLAUDE.md

# Traducciones compiladas: se regeneran con `godot4 --import` desde el .csv
*.translation

# Python
__pycache__/
*.pyc
