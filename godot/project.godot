; Proyecto Godot de SIGA-98 · Expediente Legado.
; Durante la migración convive con la app Spring de backend/: esta carpeta no
; depende de ella, y el contenido llega por datos/casos.json.

config_version=5

[application]

config/name="SIGA-98 · Expediente Legado"
run/main_scene="res://escenas/inicio.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GestorLiteratura=res://godot/literatura/gestor_literatura.gd
GestorArquetipos=
GestorMomentum=
GestorCombos=res://godot/combate/combos.gd
res://godot/combate/momentum.gd
res://godot/arquetipos/gestor_arquetipos.gd

MezclaAudio="*res://guion/mezcla_audio.gd"
MenuGlobal="*res://guion/menu_global.gd"
MenuSalidaInicio="*res://guion/menu_salida_inicio.gd"
VestuarioHumano3D="*res://guion/vestuario_humano_3d.gd"
CorreccionVisualNPC275="*res://guion/correccion_visual_npc_275.gd"
ConsolaDepuracion="*res://guion/cargador_consola_depuracion.gd"

[rendering]

; Forward+ a partir de #275: el tratamiento visual de los NPC y de la luz
; necesita sombras, SSAO y SSIL, que Compatibility no ofrece. El precio está
; medido: bajo rasterización por software —el perfil de los runners— Forward+
; cuesta cerca del doble por cuadro. En hardware real el perfil es otro.
;
; Pendiente del cambio: once workflows y documentos siguen fijando
; `--rendering-method gl_compatibility` por línea de órdenes, así que esos
; gates miden todavía el renderer anterior. Y `decal_compat.gd` existe porque
; Compatibility no dibuja el nodo `Decal`: con Forward+ deja de ser necesario,
; aunque sigue funcionando y no se toca aquí.
renderer/rendering_method="forward_plus"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[input]

avanzar_stick={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":1,"axis_value":-1.0,"script":null)
]
}
retroceder_stick={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":1,"axis_value":1.0,"script":null)
]
}
mirar_izquierda={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":2,"axis_value":-1.0,"script":null)
]
}
mirar_derecha={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":2,"axis_value":1.0,"script":null)
]
}
mirar_arriba={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":3,"axis_value":-1.0,"script":null)
]
}
mirar_abajo={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":3,"axis_value":1.0,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://datos/textos.es.translation")