[configuration]

entry_symbol = "siga98_gb_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.x86_64.single.debug = "./bin/linux/libsiga98_gb.linux.template_debug.x86_64.so"
linux.x86_64.single.release = "./bin/linux/libsiga98_gb.linux.template_release.x86_64.so"
windows.x86_64.single.release = "./bin/windows/siga98_gb.windows.template_release.x86_64.dll"
