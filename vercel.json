{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/report.js": {
      "maxDuration": 10
    }
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- api vercel.json .vercelignore"
}
